APP_ENV=development
APP_MODE=demo
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@DEV-POOLER-HOST/DB?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DEV-DIRECT-HOST/DB?sslmode=require
AI_ENABLED=false
OPENAI_MODEL=gpt-6-luna
# Enable only after setting the server-side key. A missing key gives an honest rules-based brief.
# OPENAI_API_KEY=
AI_BUDGET_MICRO_USD=1000000
AI_RESERVATION_MICRO_USD=10000
AI_DAILY_LIMIT=30
AI_COOLDOWN_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1000
MAX_IMPORT_BYTES=2000000
MAX_IMPORT_ROWS=5000

# Fixed accounts are created explicitly with npm run auth:setup.
# Default emails: admin@smarterp.local, operations@smarterp.local, finance@smarterp.local.
# Passwords are generated once and printed by auth:setup unless supplied below.
# Existing accounts/passwords are never replaced by ordinary setup or deployment.
# SMARTERP_ADMIN_EMAIL=admin@smarterp.local
# SMARTERP_ADMIN_PASSWORD=
# SMARTERP_OPERATIONS_EMAIL=operations@smarterp.local
# SMARTERP_OPERATIONS_PASSWORD=
# SMARTERP_FINANCE_EMAIL=finance@smarterp.local
# SMARTERP_FINANCE_PASSWORD=

# Hosted profiles: npm run profile -- staging init (or production init).
# Edit the generated, git-ignored .env.staging.local; keep .env.local for your local DB.
# Netlify runtime app values belong in the UI, all scopes on Free.
# AWS_LAMBDA_JS_RUNTIME=nodejs24.x (Netlify UI only; not a local profile key).
# Never give every isolated DB a fresh paid-AI allowance; first hosted AI stays disabled.
